generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmployeeStatus {
  ACTIVE
  ONBOARDING
  ON_LEAVE
  EXITED
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TimesheetStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayrollRunStatus {
  DRAFT
  PROCESSED
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  departments         Department[]
  employees           Employee[]
  roles               Role[]
  attendanceRecords   AttendanceRecord[]
  leaveTypes          LeaveType[]
  leaveBalances       LeaveBalance[]
  leaveRequests       LeaveRequest[]
  announcements       Announcement[]
  onboardingTasks     OnboardingTask[]
  shiftTemplates      ShiftTemplate[]
  shiftAssignments    ShiftAssignment[]
  timesheetEntries    TimesheetEntry[]
  compensationRecords CompensationRecord[]
  payrollRuns         PayrollRun[]
  payslips            Payslip[]

  @@map("organizations")
}

model User {
  id             String   @id @default(uuid())
  organizationId String
  email          String
  passwordHash   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee?
  userRoles    UserRole[]

  @@unique([organizationId, email])
  @@map("users")
}

model Department {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  parentId       String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children     Department[] @relation("DepartmentHierarchy")
  employees    Employee[]

  @@unique([organizationId, name])
  @@map("departments")
}

model Employee {
  id             String         @id @default(uuid())
  organizationId String
  userId         String         @unique
  employeeCode   String
  firstName      String
  lastName       String
  designation    String?
  phone          String?
  departmentId   String?
  managerId      String?
  dateOfJoining  DateTime?
  status         EmployeeStatus @default(ONBOARDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  department    Department?  @relation(fields: [departmentId], references: [id])
  manager       Employee?    @relation("ManagerHierarchy", fields: [managerId], references: [id])
  directReports Employee[]   @relation("ManagerHierarchy")

  attendanceRecords AttendanceRecord[]
  leaveRequests     LeaveRequest[]     @relation("LeaveRequester")
  approvedRequests  LeaveRequest[]     @relation("LeaveApprover")
  leaveBalances     LeaveBalance[]
  announcements     Announcement[]

  onboardingTasks     OnboardingTask[]
  shiftAssignment     ShiftAssignment?
  timesheetEntries    TimesheetEntry[]     @relation("TimesheetOwner")
  approvedTimesheets  TimesheetEntry[]     @relation("TimesheetApprover")
  compensationRecords CompensationRecord[]
  payslips            Payslip[]

  @@unique([organizationId, employeeCode])
  @@map("employees")
}

model AttendanceRecord {
  id             String    @id @default(uuid())
  organizationId String
  employeeId     String
  date           DateTime  @db.Date
  checkInAt      DateTime?
  checkOutAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@map("attendance_records")
}

model LeaveType {
  id                 String   @id @default(uuid())
  organizationId     String
  name               String
  defaultDaysPerYear Int      @default(0)
  createdAt          DateTime @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]

  @@unique([organizationId, name])
  @@map("leave_types")
}

model LeaveBalance {
  id             String @id @default(uuid())
  organizationId String
  employeeId     String
  leaveTypeId    String
  year           Int
  allocatedDays  Float  @default(0)
  usedDays       Float  @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id             String             @id @default(uuid())
  organizationId String
  employeeId     String
  leaveTypeId    String
  startDate      DateTime           @db.Date
  endDate        DateTime           @db.Date
  days           Float
  reason         String?
  status         LeaveRequestStatus @default(PENDING)
  approverId     String?
  decisionNote   String?
  decidedAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation("LeaveRequester", fields: [employeeId], references: [id], onDelete: Cascade)
  approver     Employee?    @relation("LeaveApprover", fields: [approverId], references: [id])
  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id])

  @@map("leave_requests")
}

model Announcement {
  id             String   @id @default(uuid())
  organizationId String
  authorId       String
  title          String
  body           String
  publishedAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       Employee     @relation(fields: [authorId], references: [id])

  @@map("announcements")
}

model OnboardingTask {
  id             String    @id @default(uuid())
  organizationId String
  employeeId     String
  title          String
  done           Boolean   @default(false)
  dueDate        DateTime? @db.Date
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("onboarding_tasks")
}

model ShiftTemplate {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  startTime      String
  endTime        String
  createdAt      DateTime @default(now())

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shiftAssignments ShiftAssignment[]

  @@unique([organizationId, name])
  @@map("shift_templates")
}

model ShiftAssignment {
  id              String   @id @default(uuid())
  organizationId  String
  employeeId      String   @unique
  shiftTemplateId String
  effectiveFrom   DateTime @db.Date
  updatedAt       DateTime @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftTemplate ShiftTemplate @relation(fields: [shiftTemplateId], references: [id])

  @@map("shift_assignments")
}

model TimesheetEntry {
  id             String          @id @default(uuid())
  organizationId String
  employeeId     String
  date           DateTime        @db.Date
  hours          Float
  task           String?
  status         TimesheetStatus @default(PENDING)
  approverId     String?
  decidedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation("TimesheetOwner", fields: [employeeId], references: [id], onDelete: Cascade)
  approver     Employee?    @relation("TimesheetApprover", fields: [approverId], references: [id])

  @@unique([employeeId, date])
  @@map("timesheet_entries")
}

model CompensationRecord {
  id             String   @id @default(uuid())
  organizationId String
  employeeId     String
  effectiveFrom  DateTime @db.Date
  annualCTC      Float
  monthlyGross   Float
  currency       String   @default("INR")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("compensation_records")
}

model PayrollRun {
  id             String           @id @default(uuid())
  organizationId String
  month          Int
  year           Int
  status         PayrollRunStatus @default(DRAFT)
  processedAt    DateTime?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payslips     Payslip[]

  @@unique([organizationId, month, year])
  @@map("payroll_runs")
}

model Payslip {
  id             String   @id @default(uuid())
  organizationId String
  payrollRunId   String
  employeeId     String
  grossPay       Float
  deductions     Float
  netPay         Float
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payrollRun   PayrollRun   @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([payrollRunId, employeeId])
  @@map("payslips")
}

model Role {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, name])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}
